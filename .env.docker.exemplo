# ==============================================================================
# TEMPLATE: .env.docker.exemplo → .env.docker
# ==============================================================================
# Copy this file to .env.docker and configure for your environment
# DO NOT commit .env.docker to version control
# ==============================================================================

# Database Configuration (SQL Server)
DB_NAME=HexagonalLab
DB_PORT=1433
DB_PASSWORD=your_secure_password_here
DB_USER=sa

# API Service Configuration
API_PORT=5000
API_ENVIRONMENT=Development

# Application Environment
ASPNETCORE_ENVIRONMENT=Development

# Worker Service Configuration
# (Uses same database connection string as API)
WORKER_ENVIRONMENT=Development

# ==============================================================================
# DESCRIPTION
# ==============================================================================
# DB_NAME            : SQL Server database name
# DB_PORT            : SQL Server port (internal to Docker network)
# DB_PASSWORD        : SA user password (CHANGE THIS!)
# DB_USER            : SQL Server admin user
# API_PORT           : API service port (exposed to host)
# API_ENVIRONMENT    : ASP.NET Core environment for API
# ASPNETCORE_ENVIRONMENT: Global ASP.NET Core environment
# WORKER_ENVIRONMENT : Environment for background worker service
# ==============================================================================
