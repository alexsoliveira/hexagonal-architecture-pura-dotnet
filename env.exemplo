# ==============================================================================
# TEMPLATE: env.exemplo → .env
# ==============================================================================
# Copy this file to .env and fill with your credentials
# DO NOT commit .env to version control
# ==============================================================================

# Azure DevOps Integration (configure in .env)
AZURE_DEVOPS_PAT=your_personal_access_token_here
AZURE_DEVOPS_ORG=https://dev.azure.com/your_organization/
AZURE_DEVOPS_PROJECT=your_project_name

# MCP Server Configuration
MCP_TRANSPORT=transport_type_here

# Local Application Environment
ASPNETCORE_ENVIRONMENT=Production

# ==============================================================================
# NOTE: Docker environment variables are in .env.docker template
# ==============================================================================

# API Configuration
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Worker Configuration
# (Uses same database connection string)